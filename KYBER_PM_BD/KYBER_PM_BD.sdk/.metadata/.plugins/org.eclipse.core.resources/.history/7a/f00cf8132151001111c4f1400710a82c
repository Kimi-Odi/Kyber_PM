// ============================================================================
// main.c -- Kyber Polynomial Multiplier on ZedBoard  (五階段資料流 DEMO 版)
// ----------------------------------------------------------------------------
//   Terminal 完整呈現:
//     原始 a, b
//       -> NTT(a)=â , NTT(b)=b̂        (PS 軟體算,展示演算法)
//       -> PWM(â,b̂)=ĉ
//       -> INTT(ĉ)=c                  (PS 軟體算)
//     並與「硬體 PL 從 DMA 回傳的 c」+「SD 卡 golden」三方比對
//
//   PS 軟體 NTT/INTT/PWM 一字一句對應 ref_model.py / pqcrystals-kyber,
//   也就是 RTL 實作的同一套演算法 (n=256, q=3329, zeta=17, fused INTT)。
//
//   .dat 格式: ASCII hex 無換行,每 8 hex = 1 個 32-bit word (LE),
//              每 word = 1 個 24-bit binomial: [23:12]=odd, [11:0]=even
// ============================================================================
#include <stdio.h>
