static inline int modq(int x) { x %= Q; if (x < 0) x += Q; return x; }

// ---------------------------------------------------------------------------
// PS 軟體 NTT (DIT) -- 對應 ref_model.py ntt()
// ---------------------------------------------------------------------------
void sw_ntt(int *a)
{
    int k = 1, length = 128;
    while (length >= 2) {
        for (int start = 0; start < N; start += 2 * length) {
            int zeta = ZETAS[k++];
            for (int j = start; j < start + length; j++) {
                int t = modq(zeta * a[j + length]);
                a[j + length] = modq(a[j] - t);
                a[j]          = modq(a[j] + t);
            }
        }
        length >>= 1;
    }
}

// PS 軟體 INTT (fused ÷2 GS-DIF) -- 對應 ref_model.py intt()
void sw_intt(int *a)
{
    int k = 127, length = 2;
    while (length <= 128) {
        for (int start = 0; start < N; start += 2 * length) {
            int zeta = ZETAS[k--];
            for (int j = start; j < start + length; j++) {
                int t = a[j];
                a[j]          = modq((t + a[j + length]) * INV2);
                a[j + length] = modq((a[j + length] - t) * INV2);
                a[j + length] = modq(zeta * a[j + length]);
            }
        }
        length <<= 1;
    }
}

// PS 軟體 PWM -- 對應 ref_model.py pwm()
void sw_pwm(const int *a, const int *b, int *r)
{
    for (int i = 0; i < 128; i++) {
        int a0 = a[2*i], a1 = a[2*i + 1];
        int b0 = b[2*i], b1 = b[2*i + 1];
        int z  = ZETAS_PWM[i];
        r[2*i]     = modq(a0*b0 + modq(a1*b1) * z);
        r[2*i + 1] = modq(a0*b1 + a1*b0);
    }
}

// ---------------------------------------------------------------------------
// SD 卡
// ---------------------------------------------------------------------------
int sd_mount(void)
{
    if (f_mount(&fatfs, "0:/", 1) != FR_OK) {
        xil_printf("[SD] f_mount failed\r\n"); return XST_FAILURE;
    }
    return XST_SUCCESS;
}
static int hexval(char c)
{
    if (c>='0'&&c<='9') return c-'0';
    if (c>='a'&&c<='f') return c-'a'+10;
    if (c>='A'&&c<='F') return c-'A'+10;
    return -1;
}
int sd_read_dat(const char *fn, u32 *out, int nw)
{
    FIL f; FRESULT r; UINT br;
    static char txt[N_IN_WORDS*8+16];
    if (f_open(&f,fn,FA_READ)!=FR_OK){xil_printf("[SD] open %s fail\r\n",fn);return XST_FAILURE;}
    r=f_read(&f,txt,sizeof(txt)-1,&br); f_close(&f);
    if (r!=FR_OK){xil_printf("[SD] read %s fail\r\n",fn);return XST_FAILURE;}
    txt[br]='\0';
    if ((int)br < nw*8){xil_printf("[SD] %s short\r\n",fn);return XST_FAILURE;}
    for (int w=0;w<nw;w++){
        const char*p=&txt[w*8];
        int b0=(hexval(p[0])<<4)|hexval(p[1]);
        int b1=(hexval(p[2])<<4)|hexval(p[3]);
        int b2=(hexval(p[4])<<4)|hexval(p[5]);
        int b3=(hexval(p[6])<<4)|hexval(p[7]);
        out[w]=((u32)b0)|((u32)b1<<8)|((u32)b2<<16)|((u32)b3<<24);
    }
    xil_printf("[SD] %s loaded (%d words)\r\n",fn,nw);
    return XST_SUCCESS;
}

// ---------------------------------------------------------------------------
// DMA
// ---------------------------------------------------------------------------
int dma_init(void)
{
    XAxiDma_Config *c = XAxiDma_LookupConfig(DMA_DEV_ID);
    if (!c){xil_printf("[DMA] lookup fail\r\n");return XST_FAILURE;}
    if (XAxiDma_CfgInitialize(&AxiDma,c)!=XST_SUCCESS){xil_printf("[DMA] init fail\r\n");return XST_FAILURE;}
    if (XAxiDma_HasSg(&AxiDma)){xil_printf("[DMA] SG?\r\n");return XST_FAILURE;}
    XAxiDma_IntrDisable(&AxiDma,XAXIDMA_IRQ_ALL_MASK,XAXIDMA_DEVICE_TO_DMA);
    XAxiDma_IntrDisable(&AxiDma,XAXIDMA_IRQ_ALL_MASK,XAXIDMA_DMA_TO_DEVICE);
    return XST_SUCCESS;
}
int dma_run(void)
{
    Xil_DCacheFlushRange((UINTPTR)in_buf,IN_BYTES);
    Xil_DCacheFlushRange((UINTPTR)out_buf,OUT_BYTES);
    if (XAxiDma_SimpleTransfer(&AxiDma,(UINTPTR)out_buf,OUT_BYTES,XAXIDMA_DEVICE_TO_DMA)!=XST_SUCCESS)
        return XST_FAILURE;
    if (XAxiDma_SimpleTransfer(&AxiDma,(UINTPTR)in_buf,IN_BYTES,XAXIDMA_DMA_TO_DEVICE)!=XST_SUCCESS)
        return XST_FAILURE;
    while (XAxiDma_Busy(&AxiDma,XAXIDMA_DMA_TO_DEVICE)){}
    while (XAxiDma_Busy(&AxiDma,XAXIDMA_DEVICE_TO_DMA)){}
    Xil_DCacheInvalidateRange((UINTPTR)out_buf,OUT_BYTES);
    return XST_SUCCESS;
}

// ---------------------------------------------------------------------------
// 印一個階段的前 SHOW_ROWS 個 binomial:  idx | even + odd*X
// poly[] 是 256 個係數: poly[2i]=even, poly[2i+1]=odd
// ---------------------------------------------------------------------------
void print_stage(const char *title, const int *poly)
{
    xil_printf("  [%s]\r\n", title);
    for (int i = 0; i < SHOW_ROWS; i++) {
        xil_printf("     [%2d] %4d + %4d*X\r\n",
                   i, poly[2*i] % Q, poly[2*i+1] % Q);
    }
}

int main(void)
{
    xil_printf("\r\n");
    xil_printf("================================================================\r\n");
    xil_printf("  Kyber Polynomial Multiplier  (ZedBoard / Zynq-7020)\r\n");
    xil_printf("  c(x) = a(x) * b(x)  mod (X^256 + 1),  q = 3329, zeta = 17\r\n");
    xil_printf("  Data flow:  a,b -> NTT -> PWM -> INTT -> c\r\n");
    xil_printf("  3-way check:  PS-software  vs  PL-hardware  vs  golden\r\n");
    xil_printf("================================================================\r\n");

    if (dma_init() != XST_SUCCESS) return -1;
    xil_printf("[DMA] init OK\r\n");
    if (sd_mount() != XST_SUCCESS) return -1;
    xil_printf("[SD ] mounted\r\n");

    int total_fail = 0, sum_us = 0;

    for (int tc = 0; tc < 5; tc++) {
        char fn_in[16], fn_gold[16];
        strcpy(fn_in,"pm_in_0.dat");   fn_in[6]='0'+tc;
        strcpy(fn_gold,"pm_gold_0.dat"); fn_gold[8]='0'+tc;

        xil_printf("\r\n################ Test case %d ################\r\n", tc);

        if (sd_read_dat(fn_in,   in_buf,   N_IN_WORDS)  != XST_SUCCESS) break;
        if (sd_read_dat(fn_gold, gold_buf, N_OUT_WORDS) != XST_SUCCESS) break;

        // unpack in_buf -> sw_a (256), sw_b (256)
        for (int i = 0; i < 128; i++) {
            u32 wa = in_buf[i]       & 0xFFFFFF;
            u32 wb = in_buf[i + 128] & 0xFFFFFF;
            sw_a[2*i]   = wa & 0xFFF;  sw_a[2*i+1] = (wa>>12)&0xFFF;
            sw_b[2*i]   = wb & 0xFFF;  sw_b[2*i+1] = (wb>>12)&0xFFF;
        }

        // ---- 硬體 PL: DMA 跑一次 ----
        XTime t0,t1; XTime_GetTime(&t0);
        if (dma_run() != XST_SUCCESS){total_fail++;continue;}
        XTime_GetTime(&t1);
        int us=(int)(1.0e6*(double)(t1-t0)/(double)COUNTS_PER_SECOND);
        sum_us+=us;

        // ---- PS 軟體: 一步步算同一條 pipeline ----
        memcpy(sw_an, sw_a, sizeof(sw_a));
        memcpy(sw_bn, sw_b, sizeof(sw_b));
        sw_ntt(sw_an);                    // NTT(a)
        sw_ntt(sw_bn);                    // NTT(b)
        sw_pwm(sw_an, sw_bn, sw_cn);      // PWM
        memcpy(sw_c, sw_cn, sizeof(sw_cn));
        sw_intt(sw_c);                    // INTT -> 最終 c

        // ---- Terminal 呈現五階段 ----
        xil_printf("\r\n  --- Data flow (first %d binomials) ---\r\n", SHOW_ROWS);
        print_stage("Stage 0: input  a", sw_a);
        print_stage("Stage 0: input  b", sw_b);
        print_stage("Stage 1: NTT(a) = a_hat", sw_an);
        print_stage("Stage 1: NTT(b) = b_hat", sw_bn);
        print_stage("Stage 2: PWM    = c_hat", sw_cn);
        print_stage("Stage 3: INTT   = c (final)", sw_c);

        // ---- 三方比對 ----
        int err_hw_sw = 0, err_hw_gold = 0, err_sw_gold = 0;
        for (int i = 0; i < 128; i++) {
            u32 hw = out_buf[i] & 0xFFFFFF;
            int hw_e = hw & 0xFFF, hw_o = (hw>>12)&0xFFF;
            u32 gd = gold_buf[i] & 0xFFFFFF;
            int gd_e = gd & 0xFFF, gd_o = (gd>>12)&0xFFF;
            int sw_e = sw_c[2*i] % Q, sw_o = sw_c[2*i+1] % Q;

            if ((hw_e%Q)!=(sw_e%Q) || (hw_o%Q)!=(sw_o%Q)) err_hw_sw++;
            if ((hw_e%Q)!=(gd_e%Q) || (hw_o%Q)!=(gd_o%Q)) err_hw_gold++;
            if ((sw_e%Q)!=(gd_e%Q) || (sw_o%Q)!=(gd_o%Q)) err_sw_gold++;
        }

        xil_printf("\r\n  --- Hardware PL result (first %d) ---\r\n", SHOW_ROWS);
        for (int i = 0; i < SHOW_ROWS; i++) {
            u32 hw = out_buf[i] & 0xFFFFFF;
            xil_printf("     [%2d] %4d + %4d*X\r\n",
                       i, hw & 0xFFF, (hw>>12)&0xFFF);
        }

        xil_printf("\r\n  --- 3-way verification (all 128 binomials) ---\r\n");
        xil_printf("     PL hardware  vs  PS software : %s (%d diff)\r\n",
                   err_hw_sw==0?"MATCH":"FAIL", err_hw_sw);
        xil_printf("     PL hardware  vs  golden      : %s (%d diff)\r\n",
                   err_hw_gold==0?"MATCH":"FAIL", err_hw_gold);
        xil_printf("     PS software  vs  golden      : %s (%d diff)\r\n",
                   err_sw_gold==0?"MATCH":"FAIL", err_sw_gold);

        int pass = (err_hw_sw==0 && err_hw_gold==0 && err_sw_gold==0);
        xil_printf("     latency = %d us (incl. SD+DMA)\r\n", us);
        xil_printf("     >>> CASE %d  %s <<<\r\n", tc, pass?"PASS":"FAIL");
        if (!pass) total_fail++;
    }

    xil_printf("\r\n================================================================\r\n");
    if (total_fail==0)
        xil_printf("  SUMMARY:  ALL PASS  (5/5 cases, avg %d us/poly-mul)\r\n",
                   sum_us/5);
    else
        xil_printf("  SUMMARY:  %d / 5 cases FAILED\r\n", total_fail);
    xil_printf("  Pure HW compute: 1647 cycles @ 90 MHz ~= 18.3 us\r\n");
    xil_printf("  (NTT 499 + NTT 499 + PWM 138 + INTT 499 + overhead)\r\n");
    xil_printf("================================================================\r\n");

    while (1) { }
    return 0;
}